// Night Bus: a roller, written for WHEEL UP!. Original.
// 174 BPM, F# minor: F#m, D, Bm, C#m, a bar each, round and round. The bass is the
// tune: a Reese over the sub, each chord's root held and struck again off the beat,
// leaping up, never still.
// Minimal Roller kit:
//   P1 kick · P2 snare · P3 ghost · P4 rim · P5 jungle snare · P6 shaker · P7 closed hat · P8 open hat
// Steps: X accent, x hit, o ghost, . rest, | bar line. Notes: pitch:steps (C4 = middle C),
// chords as F#3+A3+C#4:16, rests as . (one step) or .:12 (twelve).
// Hype sections: every 8 bars of them is a hype phrase (WHEEL UP! needs them cleared).
Project(
    version: 1,
    meta: (
        title: "Night Bus",
        artist: "Sodium Lights",
        key: "F# minor",
        subgenre: "Roller",
    ),
    bpm: 174.0,
    swing: 0.02,
    kit: "minimal-roller",
    // Mastered to −16 LUFS: check with `wheelup-cli lufs night-bus`.
    mix: (duck: -6.0, master: -5.7, reverb: -3.0, delay: -6.0),
    // The Reese rolling over the sub: the triggers play both.
    bass: [(instrument: "sub"), (instrument: "reese", level: 0.0)],
    tracks: {
        "pad": (instrument: "atmos-pad", level: 1.0),
        "keys": (instrument: "fm-rhodes", level: 0.0, reverb: 0.4),
        "pluck": (instrument: "pluck", level: 4.0, delay: 0.6),
        "vocal": (instrument: "vocal-ah", level: -3.0, reverb: 0.6),
        "riser": (instrument: "riser", level: -4.0),
        "down": (instrument: "downlifter", level: -5.0),
        "impact": (instrument: "impact", level: -5.0),
        // Rough Rider, the Minimal Roller break: under the drops, far off before them.
        "break": (instrument: "break/rough-rider", level: -5.0),
        "far-break": (instrument: "break/rough-rider", level: -15.0),
    },
    patterns: {
        // The last bus pulling in: ghosted hats, a rim, a kick now and then.
        "intro": Drums(bars: 2, steps: {
            "P1": "X... .... .... .... | .... .... .... ....",
            "P4": ".... .... .... x... | .... .... .... x...",
            "P7": "o.o. o.o. o.o. o.o. | o.o. o.o. o.o. o.o.",
        }),
        "intro-fill": Drums(bars: 1, steps: {
            "P1": "X... .... .... ....",
            "P3": ".... .... .o.o .ooo",
            "P4": ".... .... x... x...",
            "P7": "o.o. o.o. .... ....",
        }),
        // The two-step on the rim, ghosts creeping in.
        "build": Drums(bars: 2, steps: {
            "P1": "X... .... ..x. .... | X... .... ..x. ....",
            "P3": ".... ...o .o.. ...o | .... ...o .o.. ....",
            "P4": ".... x... .... x... | .... x... .... x...",
            "P7": "..x. ..x. ..x. ..x. | ..x. ..x. ..x. ..x.",
        }),
        "roll-fill": Drums(bars: 1, steps: {
            "P1": "X... .... .... ....",
            "P2": "x.x. x.x. xxxx XXXX",
            "P6": ".... .... x.x. ....",
        }),
        // The drop: a rolling two-step, ghosts shuffling between the snares.
        "roller": Drums(bars: 2, steps: {
            "P1": "X... .... ..X. .... | X... .... ..X. ..x.",
            "P2": ".... X... .... X... | .... X... .... X...",
            "P3": "..o. ...o .o.. ...o | ..o. ...o .o.. .o.o",
            "P7": "x.x. x.x. x.x. x.x. | x.x. x.x. x.x. x...",
            "P8": ".... .... .... .... | .... .... .... ..x.",
        }),
        "roller-fill": Drums(bars: 1, steps: {
            "P1": "X... .... ..X. ....",
            "P2": ".... X... .... x.xX",
            "P3": ".... ...o .o.o ....",
            "P6": ".... .... x.x. ....",
            "P7": "x.x. x.x. .... ....",
        }),
        // Drop two: the break chopped across the jungle snare.
        "chop": Drums(bars: 2, steps: {
            "P1": "X... .... ..X. .... | X.x. .... ..X. ....",
            "P5": ".... X..o .o.. X... | .... X..o .o.. X.oo",
            "P7": "x.x. x.x. x.x. x.x. | x.x. x.x. x.x. x.x.",
        }),
        "chop-fill": Drums(bars: 1, steps: {
            "P1": "X.x. .... ..X. ....",
            "P2": ".... .... .... .xxX",
            "P5": ".... X..o .o.. X.x.",
            "P6": ".... .... x.x. ....",
            "P7": "x.x. x.x. .... ....",
        }),
        // Back from the breakdown: kick, rim and hats, the snare climbing to the gap.
        "rise": Drums(bars: 2, steps: {
            "P1": "X... .... .... .... | X... .... ..x. ....",
            "P4": ".... x... .... x... | .... x... .... x...",
            "P7": "..x. ..x. ..x. ..x. | ..x. ..x. ..x. ..x.",
        }),
        "rise-fill": Drums(bars: 1, steps: {
            "P1": "X... .... .... ....",
            "P2": ".... x.x. xxxx XXXX",
            "P4": ".... x... .... ....",
        }),
        "outro": Drums(bars: 2, steps: {
            "P1": "X... .... ..x. .... | X... .... .... ....",
            "P4": ".... x... .... x... | .... x... .... ....",
            "P7": "..x. ..x. ..x. ..x. | ..x. ..x. ..x. ..x.",
        }),
        // The roll: each chord's root held long, struck again off the beat, a leap
        // up, a step towards the next chord, legato, all between 46 and 110 Hz where
        // every system has it. The Reese's sweep does the rest.
        "rolling": Bass(bars: 4, notes: "F#1:6 . F#1:3 F#2:3 E2:3 | D2:6 . D2:3 A1:3 C#2:3 | B1:6 . B1:3 F#2:3 A1:3 | C#2:6 . C#2:3 G#1:3 E2:3"),
        // Drop two's: struck harder, walking every bar's end.
        "rolling-2": Bass(bars: 4, notes: "F#1:4 F#2:3 F#1:5 C#2:2 E2:2 | D2:4 A1:3 D2:5 C#2:2 A1:2 | B1:4 F#2:3 B1:5 A1:2 F#1:2 | C#2:4 G#1:3 C#2:5 E2:2 G#2:2"),
        // A chord a bar, under the bass.
        "pad": Notes(track: "pad", bars: 4, notes: "F#3+A3+C#4:16 | D3+F#3+A3:16 | B2+D3+F#3:16 | C#3+E3+G#3:16"),
        // The Rhodes on the offbeats.
        "keys": Notes(track: "keys", bars: 4, notes: ".:2 F#3+A3+C#4:2 .:4 F#3+A3+C#4:2 .:6 | .:2 D3+F#3+A3:2 .:4 D3+F#3+A3:2 .:6 | .:2 B2+D3+F#3:2 .:4 B2+D3+F#3:2 .:6 | .:2 C#3+E3+G#3:2 .:4 C#3+E3+G#3:2 .:6"),
        // A plucked call down the chord, the delay answering it.
        "call": Notes(track: "pluck", bars: 4, notes: ".:4 C#5:2 A4:2 F#4:4 .:4 | .:16 | .:4 E5:2 C#5:2 B4:2 A4:6 | .:16"),
        // A voice in the breakdown, a chord tone a bar.
        "voice": Notes(track: "vocal", bars: 4, notes: "C#5:16 | A4:16 | B4:16 | G#4:16"),
        // Four bars climbing to each drop, a boom as it lands, a fall into the breakdown.
        "riser": Notes(track: "riser", bars: 8, notes: ".:64 C#3:64"),
        "impact": Notes(track: "impact", bars: 16, notes: "F#2:16 .:240"),
        "fall": Notes(track: "down", bars: 8, notes: "C#5:32 .:96"),
        // The break, once round every two bars.
        "break": Notes(track: "break", bars: 2, notes: "C4:32"),
        "far-break": Notes(track: "far-break", bars: 2, notes: "C4:32"),
    },
    arrangement: [
        (name: "Intro", bars: 8, play: ["intro", "pad"], fill: "intro-fill"),
        (name: "Build", bars: 8, play: ["build", "far-break", "pad", "riser"], fill: "roll-fill", gap: 1),
        (name: "Drop", bars: 16, play: ["roller", "break", "rolling", "keys", "impact"], hype: true, fill: "roller-fill"),
        (name: "Breakdown", bars: 8, play: ["pad", "voice", "call", "fall"]),
        (name: "Rise", bars: 8, play: ["rise", "pad", "call", "riser"], fill: "rise-fill", gap: 1),
        (name: "Drop 2", bars: 16, play: ["chop", "break", "rolling-2", "call", "impact"], hype: true, fill: "chop-fill"),
        (name: "Roller", bars: 8, play: ["roller", "break", "rolling", "keys"], hype: true, fill: "roller-fill"),
        (name: "Outro", bars: 8, play: ["outro", "pad"]),
    ],
)
