// Tidewater Lights: liquid funk, written for WHEEL UP!. Original.
// 174 BPM, A minor: Am9, Fmaj7, Dm9, Em7, the liquid turnaround. Liquid Velvet kit:
//   P1 kick · P2 snare · P3 ghost · P4 clap · P5 jungle snare · P6 shaker · P7 closed hat · P8 open hat
// Steps: X accent, x hit, o ghost, . rest, | bar line. Notes: pitch:steps (C4 = middle C),
// chords as C4+E4+G4+B4:16, rests as . (one step) or .:12 (twelve).
// Hype sections: every 8 bars of them is a hype phrase (WHEEL UP! needs them cleared).
Project(
    version: 1,
    meta: (
        title: "Tidewater Lights",
        artist: "Lune Avenue",
        key: "A minor",
        subgenre: "Liquid",
    ),
    bpm: 174.0,
    swing: 0.05,
    kit: "liquid-velvet",
    // Mastered to −16 LUFS: check with `wheelup-cli lufs tidewater-lights`.
    mix: (duck: -6.0, master: -7.0, reverb: -3.0, reverb_decay: 3.4, delay: -6.0),
    // A round sub, a breath of Reese over it for warmth.
    bass: [(instrument: "sub"), (instrument: "reese", level: -10.0)],
    tracks: {
        "pad": (instrument: "supersaw-pad", level: 0.0),
        "keys": (instrument: "fm-rhodes", level: 2.0, reverb: 0.4),
        "pluck": (instrument: "pluck", level: 3.0, delay: 0.5),
        "vocal": (instrument: "vocal-ah", level: -2.0, reverb: 0.5),
        "riser": (instrument: "riser", level: -3.0),
        "down": (instrument: "downlifter", level: -4.0),
        "impact": (instrument: "impact", level: -4.0),
        // Velvet Ride, the Liquid Velvet break: rolling under the drops, far off in the build.
        "break": (instrument: "break/velvet-ride", level: -4.0),
        "far-break": (instrument: "break/velvet-ride", level: -14.0),
    },
    patterns: {
        // The tide coming in: the shaker on the beat, the hat off it, a clap on four.
        "intro-shuffle": Drums(bars: 2, steps: {
            "P1": "X... .... .... .... | .... .... .... ....",
            "P4": ".... .... .... x... | .... .... .... x...",
            "P6": "x... x... x... x... | x... x... x... x...",
            "P7": "..x. ..x. ..x. ..x. | ..x. ..x. ..x. ..x.",
        }),
        "intro-fill": Drums(bars: 1, steps: {
            "P1": "X... .... .... ....",
            "P2": ".... .... ..x. .xxx",
            "P3": ".... .... o..o ....",
            "P4": ".... .... .... x...",
            "P6": "x.x. x.x. .... ....",
            "P7": "..x. ..x. .... ....",
        }),
        // The two-step on the clap, ghosts creeping in.
        "build": Drums(bars: 2, steps: {
            "P1": "X... .... ..x. .... | X... .... ..x. ....",
            "P3": ".... ...o .o.. ...o | .... ...o .o.. ....",
            "P4": ".... x... .... x... | .... x... .... x...",
            "P6": "x... x... x... x... | x... x... x... x...",
            "P7": "..x. ..x. ..x. ..x. | ..x. ..x. ..x. ..x.",
        }),
        // The snare rolling up to the silence before the drop.
        "roll-fill": Drums(bars: 1, steps: {
            "P1": "X... .... .... ....",
            "P2": "x.x. x.x. xxxx XXXX",
            "P6": "x.x. x.x. xxxx ....",
        }),
        // The drop: a two-step over the break's rolling ride, the shaker whispering.
        "roll": Drums(bars: 2, steps: {
            "P1": "X... .... ..X. .... | X... .... ..X. ..x.",
            "P2": ".... X... .... X... | .... X... .... X...",
            "P3": ".... ...o .o.. ...o | .o.. ...o .o.. ....",
            "P7": "..x. ..x. ..x. ..x. | ..x. ..x. ..x. ....",
            "P8": ".... .... .... .... | .... .... .... ..x.",
        }),
        // Snares and the break's own snare tumbling out of every eight bars.
        "drop-fill": Drums(bars: 1, steps: {
            "P1": "X... .... ..X. ....",
            "P2": ".... X... .... X.xx",
            "P3": ".... ...o .o.o ....",
            "P5": ".... .... x... .x..",
            "P7": "..x. ..x. .... ....",
        }),
        // Drop two: the break chopped across the jungle snare.
        "chop": Drums(bars: 2, steps: {
            "P1": "X... .... ..X. .... | X.x. .... ..X. ....",
            "P5": ".... X..o .o.. X... | .... X..o .o.. X.oo",
            "P7": "..x. ..x. ..x. ..x. | ..x. ..x. ..x. ..x.",
        }),
        "chop-fill": Drums(bars: 1, steps: {
            "P1": "X.x. .... ..X. ....",
            "P2": ".... .... ..x. .xxX",
            "P5": ".... X..o .o.. X.x.",
            "P7": "..x. ..x. .... ....",
        }),
        // Out of the breakdown: kick, shaker, hats, the clap on four…
        "rise": Drums(bars: 2, steps: {
            "P1": "X... .... .... .... | X... .... ..x. ....",
            "P4": ".... .... .... x... | .... .... .... x...",
            "P6": "x... x... x... x... | x... x... x... x...",
            "P7": "..x. ..x. ..x. ..x. | ..x. ..x. ..x. ..x.",
        }),
        // …and the snare climbing to the gap before drop two.
        "rise-fill": Drums(bars: 1, steps: {
            "P1": "X... .... .... ....",
            "P2": ".... x.x. xxxx XXXX",
            "P6": "x.x. x.x. x.x. ....",
        }),
        "outro": Drums(bars: 2, steps: {
            "P1": "X... .... ..x. .... | X... .... .... ....",
            "P2": ".... X... .... X... | .... X... .... ....",
            "P6": "x... x... x... x... | x... x... x... x...",
            "P7": "..x. ..x. ..x. ..x. | ..x. ..x. ..x. ..x.",
        }),
        // The bass walking the turnaround, A, F, D, E, a step leading into each.
        "liquid-a": Bass(bars: 4, notes: "A1:10 A1:4 G1:2 | F1:10 F1:4 C2:2 | D2:10 D2:4 F1:2 | E1:10 E1:4 G1:2"),
        // Drop two's: the same chords, stabbed and pushed, climbing back to A.
        "liquid-b": Bass(bars: 4, notes: "A1:6 . . . . A1:4 E2:2 | F1:8 . . F1:4 A1:2 | D2:3 . D2:3 . . . C2:4 A1:2 | E1:8 . . G1:2 A1:2 B1:2"),
        // Held roots under the breakdown; the rise drops them, so the drop brings them back.
        "drone": Bass(bars: 8, notes: "A1:32 | F1:32 | D2:32 | E1:32"),
        // Strings over the turnaround, two bars a chord.
        "pad": Notes(track: "pad", bars: 8, notes: "A3+C4+E4+G4:32 | F3+A3+C4+E4:32 | D3+F3+A3+C4:32 | E3+G3+B3+D4:32"),
        // The Rhodes, held, then comping in the drops: Am9, Fmaj7, Dm9, Em7, voiced close.
        "keys-long": Notes(track: "keys", bars: 8, notes: "C4+E4+G4+B4:32 | C4+E4+F4+A4:32 | C4+D4+F4+A4:32 | B3+D4+E4+G4:32"),
        "comp": Notes(track: "keys", bars: 4, notes: "C4+E4+G4+B4:6 . . C4+E4+G4+B4:2 .:6 | C4+E4+F4+A4:6 . . C4+E4+F4+A4:2 .:6 | C4+D4+F4+A4:6 . . C4+D4+F4+A4:2 .:6 | B3+D4+E4+G4:6 . . B3+D4+E4+G4:2 .:6"),
        // A plucked call down the pentatonic, the dub delay answering it.
        "hook": Notes(track: "pluck", bars: 4, notes: ".:2 E5:2 .:2 D5:2 .:2 C5:2 A4:4 | .:16 | .:2 E5:2 .:2 G5:2 .:2 E5:2 D5:2 C5:2 | .:16"),
        // A voice over the breakdown, holding each chord's colour.
        "vocal-line": Notes(track: "vocal", bars: 8, notes: "E4:24 D4:8 | C4:32 | A3:24 B3:8 | B3:32"),
        // Four bars climbing to each drop, a boom as it lands, a fall into the breakdown.
        "riser": Notes(track: "riser", bars: 8, notes: ".:64 C3:64"),
        "impact": Notes(track: "impact", bars: 16, notes: "A2:16 .:240"),
        "fall": Notes(track: "down", bars: 8, notes: "A4:32 .:96"),
        // The break, once round every two bars.
        "break": Notes(track: "break", bars: 2, notes: "C4:32"),
        "far-break": Notes(track: "far-break", bars: 2, notes: "C4:32"),
    },
    arrangement: [
        (name: "Intro", bars: 8, play: ["intro-shuffle", "pad", "keys-long"], fill: "intro-fill"),
        (name: "Build", bars: 8, play: ["build", "far-break", "keys-long", "riser"], fill: "roll-fill", gap: 1),
        (name: "Drop", bars: 16, play: ["roll", "break", "liquid-a", "comp", "hook", "impact"], hype: true, fill: "drop-fill"),
        (name: "Breakdown", bars: 8, play: ["drone", "pad", "keys-long", "vocal-line", "fall"]),
        (name: "Rise", bars: 8, play: ["rise", "pad", "vocal-line", "riser"], fill: "rise-fill", gap: 1),
        (name: "Drop 2", bars: 16, play: ["chop", "break", "liquid-b", "comp", "vocal-line", "impact"], hype: true, fill: "chop-fill"),
        (name: "Roller", bars: 8, play: ["roll", "break", "liquid-a", "comp", "hook"], hype: true, fill: "drop-fill"),
        (name: "Outro", bars: 8, play: ["outro", "pad", "keys-long"]),
    ],
)
