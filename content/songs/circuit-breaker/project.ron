// Circuit Breaker: neurofunk, written for WHEEL UP!. Original.
// 174 BPM, G# phrygian: the A a half step over the root is the menace. G#m, A, E,
// F#m, a bar each. The bass talks: sub, Reese and wobble in one, cut short, in the
// gaps between the doubled kicks, an octave apart, the A pulling at it. Neuro Lab kit:
//   P1 kick · P2 snare · P3 ghost · P4 rim · P5 jungle snare · P6 low tom · P7 closed hat · P8 open hat
// Steps: X accent, x hit, o ghost, . rest, | bar line. Notes: pitch:steps (C4 = middle C),
// chords as G#3+B3+D#4:16, rests as . (one step) or .:12 (twelve).
// Hype sections: every 8 bars of them is a hype phrase (WHEEL UP! needs them cleared).
Project(
    version: 1,
    meta: (
        title: "Circuit Breaker",
        artist: "Faraday Cage",
        key: "G# phrygian",
        subgenre: "Neurofunk",
    ),
    bpm: 174.0,
    swing: 0.0,
    kit: "neuro-lab",
    // Mastered to −16 LUFS: check with `wheelup-cli lufs circuit-breaker`.
    mix: (drums: -3.0, bass: 1.5, duck: -7.0, master: -6.7, reverb: -5.0, delay: -7.0),
    // Sub, Reese and wobble struck together: the triggers play all three.
    bass: [(instrument: "sub"), (instrument: "reese", level: 2.0), (instrument: "wobble", level: -6.0)],
    tracks: {
        "pad": (instrument: "supersaw-pad", level: -4.0),
        "stab": (instrument: "rave-stab", level: 4.0),
        "choir": (instrument: "vocal-oh", level: -4.0, reverb: 0.5),
        "siren": (instrument: "dub-siren", level: -4.0),
        "riser": (instrument: "riser", level: -3.0),
        "down": (instrument: "downlifter", level: -4.0),
        "impact": (instrument: "impact", level: -4.0),
        // Tin Can under drop one, Bunker Funk under drop two, Tin Can far off before them.
        "break": (instrument: "break/tin-can", level: -6.0),
        "break-2": (instrument: "break/bunker-funk", level: -6.0),
        "far-break": (instrument: "break/tin-can", level: -15.0),
    },
    patterns: {
        // Power coming up: a rim ticking, ghosted hats, a kick every other bar.
        "intro": Drums(bars: 2, steps: {
            "P1": "X... .... .... .... | .... .... .... ....",
            "P4": ".... .... x... .... | .... .... x... ..x.",
            "P7": "o.o. o.o. o.o. o.o. | o.o. o.o. o.o. o.o.",
        }),
        "intro-fill": Drums(bars: 1, steps: {
            "P1": "X... .... .... ....",
            "P3": ".... .... .o.o .ooo",
            "P4": ".... .... x... x...",
            "P7": "o.o. o.o. .... ....",
        }),
        // The two-step tightening, the tom answering the snare.
        "build": Drums(bars: 2, steps: {
            "P1": "X... .... ..x. .... | X... .... ..x. ....",
            "P2": ".... x... .... x... | .... x... .... x...",
            "P6": ".... .... .... .... | .... .... .... .x..",
            "P7": "x.x. x.x. x.x. x.x. | x.x. x.x. x.x. x.x.",
        }),
        "roll-fill": Drums(bars: 1, steps: {
            "P1": "X... .... .... ....",
            "P2": "x.x. x.x. xxxx XXXX",
            "P6": ".... .... x.x. ....",
        }),
        // The drop: a tight two-step, the kick doubling, ghosts in the gaps.
        "neuro": Drums(bars: 2, steps: {
            "P1": "X... .... ..X. ..x. | X... ..x. ..X. ....",
            "P2": ".... X... .... X... | .... X... .... X...",
            "P3": ".... ..o. .... .o.. | .... .... .o.. .o.o",
            "P5": ".... .... .... .... | ..x. .... .... ....",
            "P7": "x.x. x.x. x.x. x.x. | x... x.x. x.x. x.x.",
            "P8": ".... .... .... .... | .... .... .... ..x.",
        }),
        "neuro-fill": Drums(bars: 1, steps: {
            "P1": "X... .... ..X. ....",
            "P2": ".... X... ..x. xXxX",
            "P6": ".... .... x... ....",
            "P7": "x.x. x.x. .... ....",
        }),
        // Drop two: the kick pushing harder, the rim edited in between.
        "neuro-2": Drums(bars: 2, steps: {
            "P1": "X... ..x. ..X. .... | X.x. .... ..X. ..x.",
            "P2": ".... X... .... X... | .... X... .... X...",
            "P4": "..x. .... .x.. .... | ..x. .... .x.. ..x.",
            "P7": "x.x. x.x. x.x. x.x. | x.x. x.x. x.x. x.x.",
        }),
        // Back from the breakdown: kick and rim, the snare climbing to the gap.
        "rise": Drums(bars: 2, steps: {
            "P1": "X... .... .... .... | X... .... ..x. ....",
            "P4": ".... x... .... x... | .... x... .... x...",
            "P7": "..x. ..x. ..x. ..x. | ..x. ..x. ..x. ..x.",
        }),
        "rise-fill": Drums(bars: 1, steps: {
            "P1": "X... .... .... ....",
            "P2": ".... x.x. xxxx XXXX",
            "P4": ".... x... .... ....",
        }),
        "outro": Drums(bars: 2, steps: {
            "P1": "X... .... ..x. .... | X... .... .... ....",
            "P4": ".... x... .... x... | .... x... .... ....",
            "P7": "x.x. x.x. x.x. x.x. | x.x. x.x. x.x. x.x.",
        }),
        // The riff, in the kicks' gaps: the root with the downbeat, struck again,
        // a flick of the next note before the kick, the octave after it.
        "riff": Bass(bars: 4, notes: "G#1:3 .:2 G#1:2 .:2 A1:1 . G#2:3 .:2 | A1:3 . A1:2 . E2:2 .:2 C#2:3 .:2 | E1:3 .:2 E1:2 .:2 F#1:1 . E2:3 .:2 | F#1:3 . F#1:2 . C#2:2 .:2 A1:3 .:2"),
        // Drop two's: octave pairs around drop two's kicks, the A dragging each bar home.
        "riff-2": Bass(bars: 4, notes: "G#1:2 G#2:2 .:3 G#1:2 .:2 A1:2 G#1:3 | A1:2 . A2:2 . A1:3 .:2 C#2:3 . A1:1 | E1:2 E2:2 .:3 E1:2 .:2 F#1:2 E1:3 | F#1:2 . F#2:2 . F#1:3 .:2 A1:3 . F#1:1"),
        // A cold pad, a chord a bar.
        "pad": Notes(track: "pad", bars: 4, notes: "G#3+B3+D#4:16 | A3+C#4+E4:16 | G#3+B3+E4:16 | F#3+A3+C#4:16"),
        // Stabs off the beat (minor sevenths on G#, C# and F#: all in the mode).
        "stabs": Notes(track: "stab", bars: 4, notes: ".:6 G#4:2 .:8 | .:10 C#4:2 .:4 | .:6 G#4:2 .:8 | .:4 F#4:2 .:10"),
        // A dark choir over the breakdown.
        "choir": Notes(track: "choir", bars: 8, notes: "D#4:32 | E4:32 | B3:32 | C#4:32"),
        "siren": Notes(track: "siren", bars: 8, notes: "D#5:12 .:4 | .:112"),
        // Four bars climbing to each drop, a boom as it lands, a fall into the breakdown.
        "riser": Notes(track: "riser", bars: 8, notes: ".:64 C#3:64"),
        "impact": Notes(track: "impact", bars: 16, notes: "G#2:16 .:240"),
        "fall": Notes(track: "down", bars: 8, notes: "D#5:32 .:96"),
        // The breaks: Tin Can is four bars round, Bunker Funk two.
        "break": Notes(track: "break", bars: 4, notes: "C4:64"),
        "break-2": Notes(track: "break-2", bars: 2, notes: "C4:32"),
        "far-break": Notes(track: "far-break", bars: 4, notes: "C4:64"),
    },
    arrangement: [
        (name: "Intro", bars: 8, play: ["intro", "pad"], fill: "intro-fill"),
        (name: "Build", bars: 8, play: ["build", "far-break", "pad", "riser"], fill: "roll-fill", gap: 1),
        (name: "Drop", bars: 16, play: ["neuro", "break", "riff", "stabs", "impact"], hype: true, fill: "neuro-fill"),
        (name: "Breakdown", bars: 8, play: ["pad", "choir", "fall"]),
        (name: "Rise", bars: 8, play: ["rise", "pad", "riser"], fill: "rise-fill", gap: 1),
        (name: "Drop 2", bars: 16, play: ["neuro-2", "break-2", "riff-2", "stabs", "siren", "impact"], hype: true, fill: "neuro-fill"),
        (name: "Roller", bars: 8, play: ["neuro", "break", "riff", "stabs"], hype: true, fill: "neuro-fill"),
        (name: "Outro", bars: 8, play: ["outro", "pad"]),
    ],
)
